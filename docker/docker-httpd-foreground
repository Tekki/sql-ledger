#!/bin/sh
set -e

if [ ! -f config/sql-ledger.yml ]; then
  cp config/sql-ledger-sample.yml config/sql-ledger.yml
  util/update-config.pl
fi

sed -i -e 's|#$gpg.*|$gpg = "gpg --homedir /usr/local/apache2/gnupg --batch --yes";|' sql-ledger.conf

chown -R www-data:www-data images notes spool templates users

# Apache gets grumpy about PID files pre-existing
rm -f /usr/local/apache2/logs/httpd.pid

exec httpd -DFOREGROUND
